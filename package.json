{
    "name": "term-keymap",
    "version": "0.2.6",
    "description": "Parse stdin buffers into readable data and assign keymaps.",
    "main": "./dist/index.js",
    "exports": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
    },
    "files": [
        "dist/"
    ],
    "scripts": {
        "clean": "[ -d dist ] && rm -r dist; [ -d ./examples/dist ] && rm -r ./examples/dist; [ -d ./benchmark/dist ] && rm -r ./benchmark/dist",
        "build": "npm run clean; tsc; tsc -p examples; tsc -p benchmark",
        "test": "tsc && npx vitest",
        "publish": "npm run build && npm publish --access=public",
        "example:stateful": "tsc -p examples && node ./examples/dist/examples/stateful.js",
        "example:parse": "tsc -p examples && node ./examples/dist/examples/parse.js",
        "example:mouse": "tsc -p examples && node ./examples/dist/examples/mouse.js",
        "example:mouse-state": "tsc -p examples && node ./examples/dist/examples/mouseState.js",
        "example:leader": "tsc -p examples && node ./examples/dist/examples/leader.js",
        "benchmark": "tsc -p benchmark && node ./benchmark/dist/benchmark/benchmarkStateful.js"
    },
    "type": "module",
    "keywords": [
        "stdin",
        "terminal",
        "tty",
        "vim",
        "neovim",
        "keymap",
        "mouse",
        "parse",
        "buffer"
    ],
    "author": "Maxwell Morrissey",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^22.20.1",
        "eslint": "^9.26.0",
        "globals": "^16.0.0",
        "typescript-eslint": "^8.31.1",
        "vitest": "^3.1.2"
    }
}
