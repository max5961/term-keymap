{
    "name": "term-keymap",
    "version": "0.1.5",
    "description": "Parse stdin buffers into readable data and assign keymaps.",
    "main": "./dist/index.js",
    "exports": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
    },
    "files": [
        "dist/"
    ],
    "scripts": {
        "clean": "[ -d dist ] && rm -r dist; [ -d compiled-examples ] && rm -r compiled-examples",
        "build": "npm run clean; tsc; tsc -p examples",
        "test": "tsc && npx vitest",
        "lint": "eslint",
        "fix": "eslint --fix",
        "publish": "npm run build && npm publish --access=public",
        "example:stateful": "tsc -p examples && node ./compiled-examples/examples/stateful.js",
        "example:parse": "tsc -p examples && node ./compiled-examples/examples/parse.js",
        "example:mouse": "tsc -p examples && node ./compiled-examples/examples/mouse.js",
        "example:leader": "tsc -p examples && node ./compiled-examples/examples/leader.js"
    },
    "type": "module",
    "keywords": [
        "stdin",
        "terminal",
        "tty",
        "vim",
        "neovim",
        "keymap",
        "mouse",
        "parse",
        "buffer"
    ],
    "author": "Maxwell Morrissey",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^22.20.1",
        "eslint": "^9.26.0",
        "globals": "^16.0.0",
        "typescript-eslint": "^8.31.1",
        "vitest": "^3.1.2"
    }
}
